index 0000000..0395ea7
--- /dev/null
+++ b/src/utils/restoreProgress.ts
@@ -0,0 +1,48 @@
+import LevelResult from "../enums/LevelResult";
+import { AssessmentData, ProgressData } from "../types/types";
+
+// Changed category keys, indexed by their 1.1.0 key. Some old keys were
+// reused, so always read from the original save while building the new map.
+const previousKeys: Record<string, string> = {
+  "M.6": "M.5", // Key management
+  "M.7": "M.6", // Certificate management
+  "O.10": "O.15", // Resilience
+  "O.11": "O.13", // Automation
+  "O.12": "O.7", // Interoperability
+  "O.13": "O.12", // Monitoring and auditing
+  "R.14": "R.10", // Sourcing
+  "R.15": "R.11", // Knowledge and training
+  "R.16": "R.14", // Awareness
+};
+
+export function restoreProgress(
+  model: AssessmentData,
+  saved: Record<string, ProgressData> = {},
+  savedVersion?: string,
+): Record<string, ProgressData> {
+  // Unversioned saves included every category. These keys only existed in
+  // the previous layout, so unversioned 1.1.0 saves can still load as-is.
+  const legacyLayout =
+    model.version === "1.1.0" &&
+    (savedVersion === "1.0.0" ||
+      (!savedVersion && ["M.5", "O.15", "R.10"].some((key) => key in saved)));
+
+  const progress: Record<string, ProgressData> = {};
+  for (const module of model.modules) {
+    for (const category of module.categories) {
+      const key = `${module.id}.${category.id}`;
+      const choice = saved[legacyLayout ? (previousKeys[key] ?? key) : key];
+      const level = choice?.level ?? 1;
+      const applicability = choice?.applicability ?? true;
+      progress[key] = {
+        level,
+        applicability,
+        result: LevelResult[applicability ? level : -1],
+        description:
+          category.levels.find((entry) => entry.number === level)
+            ?.description ?? "",
+      };
+    }
+  }
+  return progress;
+}
